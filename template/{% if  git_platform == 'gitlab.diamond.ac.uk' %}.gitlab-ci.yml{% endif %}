stages:
  - container
  - release

.build:
  tags:
    - argus
    - docker-image
  stage: container
  variables:
    GIT_SUBMODULE_STRATEGY: recursive
  image:
    name: gcr.io/kaniko-project/executor:debug
    entrypoint: [""]
  script:
    - echo 'Building image...'
    - env | grep "CI_"
    - /bin/sh .gitlab/kanikobuild.sh
    - echo "Done!"
  # uncomment to only publish on tags
  # only:
  #   refs:
  #     - tags

build_linux_runtime:
  extends: .build
  variables:
    ARCH: linux
    TARGET: runtime

build_linux_developer:
  extends: .build
  variables:
    ARCH: linux
    TARGET: developer

